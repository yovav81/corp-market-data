<</A 15 0 R/ActualText (\376\377\005\324\005\321\005\325\005\350\005\341\005\324\000 \005\334\005\340\005\331\005\331\005\350\005\325\005\352\000 \005\342\005\350\005\332\000 \005\352\005\334\000 \005\320\005\321\005\331\005\321\000\012\000T\000E\000L\000 \000A\000V\000I\000V\000 \000S\000T\000O\000C\000K\000 \000E\000X\000C\000H\000A\000N\000G\000E\000\012\0001\0008\000 \005\320\005\325\005\347\005\330\005\325\005\321\005\350\000,\000 \0002\0000\0002\0006\000\012\0004\0007\0005\0000\0009\0003\000\012\0001\0001\0001\0007\0003\0002\000 \005\321\005\321\005\347\005\351\005\324\000\012\005\334\005\333\005\321\005\325\005\323\005\324\000,\000\012\005\347\005\350\005\323\005\337\000 \005\340\005\323\005\334\000"\005\337\000 \005\331\005\331\005\326\005\325\005\335\000 \005\325\005\344\005\331\005\352\005\325\005\327\000 \005\321\005\342\000"\005\336\000\012\005\323\005\350\005\332\000 \005\336\005\340\005\327\005\335\000 \005\321\005\322\005\331\005\337\000 \0001\0005\0004\000\012\005\352\005\334\000 \005\320\005\321\005\331\005\321\000 \0006\0004\0009\0002\0001\0000\0007\000\012\005\333\005\321\005\323\005\324\000,\000\012\005\352\005\340\005\325\005\323\005\324\000:\000 \005\320\005\331\005\351\005\325\005\350\000 \005\334\005\350\005\331\005\351\005\325\005\335\000 \005\340\005\331\005\331\005\350\005\325\005\352\000 \005\342\005\350\005\332\000 \005\334\005\336\005\341\005\327\005\350\000 \005\321\005\321\005\325\005\350\005\341\005\324\000 \005\342\005\334\000 \005\344\005\331\000 \005\323\005\331\005\325\005\325\005\327\000 \005\324\005\346\005\342\005\352\000 \005\336\005\340\005\343\000\012\0001\000.\000 \005\321\005\324\005\336\005\351\005\332\000 \005\334\005\320\005\331\005\351\005\325\005\350\005\340\005\325\000 \005\324\005\320\005\350\005\342\005\331\000 \005\336\005\331\005\325\005\335\000 \0001\0003\000.\0008\000.\0002\0006\000 \005\336\005\341\005\336\005\325\005\332\000 \005\334\005\276\0004\0007\0001\0003\0005\0000\000,\000 \005\340\005\331\005\352\005\337\000 \005\334\005\333\005\335\000 \005\320\005\331\005\351\005\325\005\350\000 \005\334\005\350\005\331\005\351\005\325\005\335\000 \005\334\005\336\005\341\005\327\005\350\000 \005\351\005\334\000 \005\342\005\323\000 \0001\0008\0000\000,\0000\0000\0000\000,\0000\0000\0000\000 \005\320\005\322\000"\005\327\000 \005\336\005\331\005\331\005\340\005\331\000 \005\320\005\322\000"\005\327\000 \000\(\005\341\005\323\005\350\005\324\000 \005\326\000'\000\)\000 \005\324\005\336\005\325\005\340\005\344\005\347\005\325\005\352\000 \005\334\005\346\005\331\005\321\005\325\005\350\000.\000\012\0002\000.\000 \005\352\005\325\005\347\005\344\005\325\000 \005\351\005\334\000 \005\320\005\331\005\351\005\325\005\350\000 \005\326\005\324\000 \005\336\005\325\005\352\005\340\005\324\000 \005\321\005\350\005\331\005\351\005\325\005\335\000 \005\334\005\336\005\341\005\327\005\350\000 \005\351\005\334\000 \005\320\005\322\000"\005\327\000 \005\336\005\331\005\331\005\340\005\331\000 \005\327\005\325\005\326\005\350\000 \000\(\005\341\005\323\005\350\005\324\000 \005\326\000'\000\)\000,\000 \005\352\005\325\005\332\000 \0006\0000\000 \005\331\005\325\005\335\000 \005\336\005\331\005\325\005\335\000 \005\324\005\324\005\340\005\344\005\347\005\324\000\012\005\334\005\344\005\327\005\325\005\352\000,\000 \005\325\005\321\005\333\005\344\005\325\005\343\000 \005\334\005\351\005\331\005\340\005\325\005\331\005\331\005\335\000 \005\321\005\323\005\325\005\327\000 \005\324\005\324\005\346\005\342\005\324\000 \005\336\005\331\005\325\005\335\000 \0001\0007\000.\0008\000.\0002\0006\000,\000 \005\330\005\331\005\325\005\330\005\352\000 \005\323\005\331\005\325\005\325\005\327\000 \005\324\005\346\005\342\005\352\000 \005\336\005\340\005\343\000 \005\336\005\331\005\325\005\335\000 \0002\0004\000.\0009\000.\0002\0006\000 \005\325\005\324\005\352\005\347\005\340\005\331\005\335\000 \005\342\005\323\000 \005\334\005\331\005\325\005\335\000 \0001\0008\000.\0001\0000\000.\0002\0006\000,\000 \005\351\005\327\005\325\005\334\005\346\005\325\005\352\000 \005\333\005\320\005\337\000.\000 \005\320\005\331\005\351\005\325\005\350\000 \005\326\005\324\000 \005\333\005\344\005\325\005\343\000 \005\334\005\320\005\331\005\351\005\325\005\350\005\335\000 \005\324\005\323\005\350\005\325\005\351\000 \005\351\005\334\000 \005\324\005\334\000"\005\321\000 \005\333\005\334\000 \005\351\005\347\005\331\005\344\005\325\005\352\000\012\005\325\005\324\005\327\005\325\005\321\005\352\000 \005\324\005\327\005\325\005\321\005\324\000 \000\(\005\341\005\323\005\350\005\325\005\352\000 \005\326\000'\000\)\000 \005\333\005\333\005\334\000 \005\351\005\352\005\352\000 \005\342\005\352\005\324\000,\000 \005\325\005\321\005\333\005\344\005\325\005\343\000 \005\334\005\324\005\351\005\334\005\335\000 \005\326\005\333\005\325\005\352\000 \005\324\005\350\005\331\005\351\005\325\005\335\000 \005\325\005\324\005\330\005\331\005\344\005\325\005\334\000\012\005\321\005\325\005\350\005\341\005\324\000 \005\325\005\336\005\331\005\334\005\325\005\331\000 \005\333\005\334\000 \005\324\005\331\005\352\005\350\000 \005\324\005\352\005\340\005\320\005\331\005\335\000 \005\324\005\347\005\321\005\325\005\342\005\331\005\335\000 \005\321\005\352\005\347\005\340\005\325\005\337\000 \005\324\005\321\005\325\005\350\005\341\005\324\000.\000\012\0003\000.\000 \005\320\005\331\005\337\000 \005\334\005\350\005\320\005\325\005\352\000 \005\321\005\320\005\331\005\351\005\325\005\350\000 \005\326\005\324\000 \005\351\005\334\000 \005\324\005\321\005\325\005\350\005\341\005\324\000 \005\320\005\331\005\351\005\325\005\350\000 \005\334\005\344\005\350\005\330\005\331\005\335\000 \005\324\005\336\005\325\005\344\005\331\005\342\005\331\005\335\000 \005\321\005\323\005\325\005\327\000 \005\324\005\346\005\342\005\352\000 \005\336\005\340\005\343\000,\000 \005\320\005\325\000 \005\334\005\324\005\336\005\334\005\346\005\325\005\352\000\012\005\320\005\325\000 \005\334\005\351\005\334\005\336\005\325\005\352\005\325\000 \005\325\005\320\005\331\005\337\000 \005\321\005\336\005\325\005\351\000 \005\323\005\325\005\327\000 \005\326\005\324\000 \005\334\005\351\005\336\005\351\000 \005\342\005\334\000 \005\324\005\327\005\321\005\350\005\324\000 \005\342\005\334\000 \005\331\005\323\005\331\000 \005\340\005\331\005\331\005\350\005\325\005\352\000 \005\324\005\342\005\350\005\332\000 \005\324\005\336\005\325\005\344\005\331\005\342\005\331\005\335\000 \005\321\005\323\005\325\005\327\000\012\005\324\005\346\005\342\005\352\000 \005\336\005\340\005\343\000 \005\320\005\325\000 \005\333\005\334\000 \005\324\005\336\005\327\005\331\005\350\000 \005\321\005\325\000 \005\324\005\335\000 \005\336\005\325\005\346\005\342\005\331\005\335\000.\000\012\005\321\005\327\005\351\005\321\005\325\005\337\000\012\0005\000.\000 \005\334\005\321\005\331\005\350\005\325\005\350\000 \005\342\005\334\000 \005\333\005\334\000 \005\351\005\331\005\340\005\325\005\331\000 \005\321\005\331\005\337\000 \005\330\005\331\005\325\005\330\005\325\005\352\000 \005\324\005\346\005\342\005\352\000 \005\324\005\336\005\340\005\343\000 \005\351\005\324\005\325\005\346\005\322\005\352\000 \005\334\005\340\005\325\000 \005\334\005\321\005\331\005\337\000 \005\323\005\331\005\325\005\325\005\327\000 \005\324\005\346\005\342\005\352\000 \005\324\005\336\005\340\005\343\000 \005\324\005\341\005\325\005\344\005\331\000.\000\012\005\321\000.\000 \005\334\005\340\005\321\005\331\005\320\000 \005\320\005\331\005\351\005\325\005\350\005\340\005\325\000 \005\342\005\334\000 \005\351\005\331\005\340\005\325\005\331\005\331\005\335\000 \005\330\005\323\005\335\000 \005\351\005\331\005\340\005\325\005\331\005\331\005\335\000 \005\321\005\336\005\341\005\322\005\350\005\352\000 \005\324\005\346\005\342\005\352\000 \005\324\005\336\005\340\005\343\000 \005\351\005\324\005\325\005\346\005\322\005\324\000.\000\012\005\322\000.\000 \005\342\005\334\000 \005\351\005\331\005\340\005\325\005\331\005\331\005\335\000 \005\325\005\3